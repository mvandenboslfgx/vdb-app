# =============================================================================
# VDB Digital — Client-safe environment variables
# Copy to `.env` for local development. Never commit real secrets.
# =============================================================================

# development | preview | production | test
EXPO_PUBLIC_APP_ENV=development

# Demo mode: ONLY allowed when APP_ENV=development (or test).
# Default false. Preview/production HARD FAIL if true.
EXPO_PUBLIC_ENABLE_DEMO_MODE=false

# Supabase (anon key only — never the service role key)
# Local: http://127.0.0.1:54321 + anon key from `npx supabase status`
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public site / deep-link base
EXPO_PUBLIC_SITE_URL=https://vdbdigital.nl

# Support contact (shown in app)
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_WHATSAPP_NUMBER=

# Observability (public DSN only)
EXPO_PUBLIC_SENTRY_DSN=

# EAS project id (from `eas init`)
EXPO_PUBLIC_EAS_PROJECT_ID=

# =============================================================================
# Server-only (DO NOT put these in the mobile client or EXPO_PUBLIC_*)
# Store in EAS Secrets / Edge Function secrets / CI secrets only.
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=
# MOLLIE_API_KEY=           # test_… only in development/staging
# MOLLIE_WEBHOOK_SECRET=
# SENTRY_AUTH_TOKEN=
# FIREBASE_SERVER_CREDENTIALS=
# DATABASE_URL=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_PASSWORD=
